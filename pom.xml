<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.opensbpm</groupId>
    <artifactId>opensbpm</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>OpenSBPM Application</name>
    <description>OpenSBPM Application</description>
    <url>http://opensbpm.org</url>
    <organization>
        <name>OpenSBPM</name>
        <url>http://opensbpm.org</url>
    </organization>

    <developers>
        <developer>
            <name>Stefan Sedelmaier</name>
            <email>stefan@sedelmaier.at</email>
        </developer>
    </developers>

    <modules>
        <module>authorization-server</module>
        <module>resource-server</module>
        <module>client-server</module>
    </modules>

    <scm>
        <connection>scm:git:git@github.com:opensbpm/opensbpm.git</connection>
        <developerConnection>scm:git:git@github.com:opensbpm/opensbpm.git</developerConnection>
        <url>https://github.com/opensbpm/opensbpm</url>
    </scm>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- dependency versions -->
        <spring.boot.version>3.3.3</spring.boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
            ===================
            Import Dependencies
            ===================
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
